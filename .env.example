# ---- Django --------------------------------------------------------------
# Local work: keep DEBUG=True. In production set DEBUG=False (or remove the line).
DEBUG=True
# REQUIRED when DEBUG is off. Generate one with:
#   python3 -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=
# REQUIRED when DEBUG is off: the real domain(s), comma separated
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# In production this MUST be the real public https address: it feeds canonical URLs, sitemap.xml and og:image
SITE_URL=http://localhost:3000

# Proxies between the internet and Django. Express counts as 1 (it forwards the
# real visitor IP); put nginx in front of Express and set TRUST_PROXY=loopback.
TRUSTED_PROXY_COUNT=1

# ---- Database ------------------------------------------------------------
# Empty = SQLite (fine for local work). For PostgreSQL either:
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=5432

# ---- New-inquiry e-mail alerts to the sales team ---------------------------
# Without EMAIL_HOST the message is printed in the server log instead.
INQUIRY_NOTIFY_EMAILS=
DEFAULT_FROM_EMAIL=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# ---- Production HTTPS (only when DEBUG=False) ------------------------------
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
